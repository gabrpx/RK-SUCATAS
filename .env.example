# Copie este arquivo para .env e preencha os valores reais.
# Nenhuma variável abaixo tem fallback hardcoded no código — se estiver
# ausente, o servidor falha explicitamente na inicialização.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Service role key (Project Settings > API) — o backend usa essa, não a anon
# key, porque as tabelas novas (estoque/vendas/caixa/...) têm RLS habilitado
# sem policy pra anon/authenticated. Rode supabase/schema.sql antes de usar.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Autenticação (login único de admin via senha + JWT)
# ---------------------------------------------------------------------------
JWT_SECRET=
# Senha única de acesso ao sistema. Sem usuário, sem cadastro — só essa senha.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Melhor Envio (cotação de frete)
# ---------------------------------------------------------------------------
MELHOR_ENVIO_TOKEN=

# ---------------------------------------------------------------------------
# Mercado Livre (integração da aba Mercado Livre — anúncios, etiquetas, mensagens)
# App ID e Chave secreta vêm do DevCenter (developers.mercadolivre.com.br).
# ---------------------------------------------------------------------------
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Precisa ser IDÊNTICA à URI de redirect cadastrada no DevCenter.
MERCADOLIVRE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Shopee (integração da aba Estoque — publicar anúncio como 2º canal)
# Partner ID e Partner Key vêm do Partner Portal da Shopee (cadastro de app
# como "Partner Platform" — processo de aprovação separado, ver
# docs/proposta-publicacao-shopee.md). Nunca gravar essas duas no banco: são
# credenciais do APLICATIVO, não da loja — o token da loja fica em
# shopee_conexao (migration_045).
# ---------------------------------------------------------------------------
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Precisa ser IDÊNTICA à URL de redirect cadastrada no Partner Portal.
SHOPEE_REDIRECT_URI=
# Opcional: aponta pro host de sandbox durante os testes da FASE 8
# (https://partner.test-stable.shopeemobile.com). Sem essa variável, usa o
# host de produção (https://partner.shopeemobile.com).
SHOPEE_API_URL=

# ---------------------------------------------------------------------------
# Push notifications (Web Push/VAPID — aba Notificações)
# Gere o par de chaves com `npx web-push generate-vapid-keys`. VAPID_SUBJECT
# é um contato mailto: exigido pelo protocolo (ex: mailto:contato@rksucatas.com.br).
# Opcional: sem essas variáveis, o botão "Ativar notificações" fica
# indisponível, mas o resto do sistema funciona normalmente.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# Push notifications (FCM — app Android empacotado, aba Notificações)
# JSON inteiro da service account do projeto Firebase, numa linha só
# (Firebase Console > Project Settings > Service Accounts > Generate new
# private key). Precisa ser um projeto Firebase dedicado, com Cloud Messaging
# habilitado, com um app Android cadastrado pro package com.rksucatas.app.
# Opcional: sem essa variável, o app Android não recebe push nativo, mas o
# resto do sistema (Web Push, etc) funciona normalmente.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Config geral do servidor
# ---------------------------------------------------------------------------
PORT=
APP_URL=
NODE_ENV=
