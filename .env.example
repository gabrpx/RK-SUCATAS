# Copie este arquivo para .env e preencha os valores reais.
# Nenhuma variável abaixo tem fallback hardcoded no código — se estiver
# ausente, o servidor falha explicitamente na inicialização.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Service role key (Project Settings > API) — o backend usa essa, não a anon
# key, porque as tabelas novas (estoque/vendas/caixa/...) têm RLS habilitado
# sem policy pra anon/authenticated. Rode supabase/schema.sql antes de usar.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Autenticação (login de staff via SQLite local + JWT)
# ---------------------------------------------------------------------------
JWT_SECRET=
# Só usada no primeiro boot, pra criar o usuário "rksucatas" quando a tabela
# local_users ainda está vazia (ex: banco novo, primeiro deploy). Depois que
# o admin existe, essa variável pode ser removida sem efeito nenhum.
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Melhor Envio (cotação de frete)
# ---------------------------------------------------------------------------
MELHOR_ENVIO_TOKEN=

# ---------------------------------------------------------------------------
# Config geral do servidor
# ---------------------------------------------------------------------------
PORT=
APP_URL=
NODE_ENV=
