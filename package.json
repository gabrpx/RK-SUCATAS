{
  "name": "react-example",
  "private": true,
  "version": "1.2.4",
  "capgo": {
    "appId": "com.rksucatas.app",
    "channel": "production"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
